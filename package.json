{
	"name": "prodash",
	"version": "1.2.0",
	"private": true,
	"type": "module",
	"description": "ProDash: dashboard visual de un proyecto de Jira Cloud con reporte en PNG",
	"scripts": {
		"dev": "concurrently -k -n server,client \"node --watch server/index.js\" \"vite\"",
		"build": "tsc --noEmit && vite build",
		"start": "node server/index.js",
		"test": "node --test server/metrics.test.js server/forecast.test.js",
		"check": "node server/check.js"
	},
	"engines": {
		"node": ">=18.17"
	},
	"dependencies": {
		"express": "4.21.2"
	},
	"devDependencies": {
		"@types/react": "18.3.12",
		"@types/react-dom": "18.3.1",
		"@vitejs/plugin-react": "4.3.4",
		"concurrently": "9.1.0",
		"html-to-image": "1.11.11",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"typescript": "5.6.3",
		"vite": "5.4.11"
	}
}
