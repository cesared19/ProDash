# Copia este archivo como .env y complétalo.

# URL de tu Jira Cloud, sin barra final
JIRA_BASE_URL=https://tu-empresa.atlassian.net
# Email de la cuenta de Jira y su token de API
# (créalo en https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_EMAIL=tu-email@empresa.com
JIRA_API_TOKEN=

# Contraseña para entrar al dashboard (la misma para todos)
DASHBOARD_PASSWORD=

# Puerto (en el Mac: http://localhost:3100)
PORT=3100

# true = datos de ejemplo, sin conectarse a Jira
JIRA_MOCK=false
